# PostgreSQL (conteneur Docker)
POSTGRES_DB=supervision_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Comptes applicatifs
JAVA_SERVICE_DB_USER=java_service
JAVA_SERVICE_DB_PASSWORD=change_me
PYTHON_SERVICE_DB_USER=python_service
PYTHON_SERVICE_DB_PASSWORD=change_me

# Java service
JWT_SECRET=change_me_to_a_long_random_secret_key
JWT_EXPIRATION=86400000
SPRING_JPA_SHOW_SQL=false
FRONTEND_URL=http://localhost:5173

# Durées de validité des tokens d'authentification
RESET_TOKEN_EXPIRATION_MINUTES=15
ACTIVATION_TOKEN_EXPIRATION_HOURS=24

# Admin initial
ADMIN_INITIAL_EMAIL=admin@renault.com
ADMIN_INITIAL_PASSWORD=change_me

# Sécurité
SECURE_COOKIE=false

# CORS (Contexte Docker : frontend exposé sur le port 80)
ALLOWED_ORIGINS=http://localhost,http://localhost:80

# Inter-services
PYTHON_SERVICE_URL=http://host.docker.internal:8000

# Python service
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5

# PLC
PLC_IP=127.0.0.1
PLC_RACK=0
PLC_SLOT=0

# SendGrid (notifications email)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=your_verified_sender@example.com
SENDGRID_SENDER_NAME=Supervision Cabine de Peinture

# Worker email — traitement asynchrone de la file d'attente (envoi_notification)
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_TENTATIVES=5
EMAIL_WORKER_CRON=*/5 * * * * *

# Frontend (arguments de build Docker)
VITE_API_URL=http://localhost:8081
VITE_WS_URL=http://localhost:8081/ws

# MinIO — stockage objet (PDFs des rapports)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio
MINIO_BUCKET=rapports

# Web Push (VAPID) pour notifications navigateur natives
# Générer les clés avec : java -cp target/classes com.projet.notifications.util.VapidKeyGenerator
VAPID_PUBLIC_KEY=GENERATE_WITH_VAPID_KEY_GENERATOR
VAPID_PRIVATE_KEY=GENERATE_WITH_VAPID_KEY_GENERATOR
VAPID_SUBJECT=mailto:contact@votre-domaine.com
