# PostgreSQL (compte dédié au service Java)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/supervision_db
SPRING_DATASOURCE_USERNAME=java_service
SPRING_DATASOURCE_PASSWORD=java12345

# Service Python interne
PYTHON_SERVICE_URL=http://localhost:8000

# JWT — clé secrète longue (min. 32 caractères)
JWT_SECRET=7e2b1d6f4a8c9e0d1f3b5a7c9d0e2f4a6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e
JWT_EXPIRATION=86400000

# JPA (optionnel)
SPRING_JPA_SHOW_SQL=true

# Admin initial (à modifier impérativement en production !)
ADMIN_INITIAL_EMAIL=admin@renault.com
ADMIN_INITIAL_PASSWORD=douae123

# Sécurité (false en local, true en prod HTTPS)
SECURE_COOKIE=false

# CORS — origines autorisées (frontend Vite dev + prod)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
