# PostgreSQL (dev local — mêmes valeurs que le .env racine / Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/supervision_db
SPRING_DATASOURCE_USERNAME=java_service
SPRING_DATASOURCE_PASSWORD=change_me

# Service Python interne
PYTHON_SERVICE_URL=http://localhost:8000

# JWT — clé secrète longue (min. 32 caractères)
JWT_SECRET=change_me_to_a_long_random_secret_key
JWT_EXPIRATION=86400000
FRONTEND_URL=http://localhost:5173

# Durées de validité des tokens d'authentification
RESET_TOKEN_EXPIRATION_MINUTES=15
ACTIVATION_TOKEN_EXPIRATION_HOURS=24

# Admin initial (à modifier impérativement en production !)
ADMIN_INITIAL_EMAIL=admin@renault.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# SendGrid (notifications email)
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_SENDER_EMAIL=your_verified_sender@example.com
SENDGRID_SENDER_NAME=Supervision Cabine de Peinture

# Worker email — traitement asynchrone de la file d'attente (envoi_notification)
EMAIL_WORKER_BATCH_SIZE=20
EMAIL_WORKER_MAX_TENTATIVES=5
EMAIL_WORKER_CRON=*/5 * * * * *

# JPA (optionnel)
SPRING_JPA_SHOW_SQL=true

# MinIO (stockage objet pour rapports PDF)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rapports-pdf
